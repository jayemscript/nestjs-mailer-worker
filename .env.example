# ===== Application =====
PORT=7002
NODE_ENV=development

# Optional Node DNS override. Leave unset in staging/production unless needed.
DNS_SERVERS=

# ===== Redis Cache =====
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TIMEOUT=5000
REDIS_RETRIES=3

# Database (MongoDB) local
MONGO_URI=mongodb://localhost:27017
#DOCKER
MONGO_URI=mongodb://host.docker.internal:27017
# ATLAS
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.qanojin.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=mail_logs
# ----- MongoDB Auth (production docker-compose only) -----
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your_strong_mongo_password_here

# ----- Cookie -----
COOKIE_SECRET=your_cookie_secret_here
COOKIE_SAMESITE=lax
COOKIE_EXPIRATION=86400000

# ===== CORS Configuration =====
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Mail provider: gmail or smtp
MAIL_PROVIDER=smtp
# Delay between emails sent by POST /mail/send-bulk. Helps avoid SMTP throttling.
BULK_SEND_DELAY_MS=750

# GoDaddy Professional Email / Professional Email powered by Titan
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=connect@themealguides.com
SMTP_PASS=your_professional_email_password
SMTP_FROM=connect@themealguides.com
# Required to encrypt SMTP account credentials stored in MongoDB.
# Generate a 32-byte value, then use base64 or 64-character hex encoding.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_CREDENTIALS_ENCRYPTION_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_USER=you@gmail.com

API_KEYS=app_key_your_core_nestjs_app,app_key_another_app
